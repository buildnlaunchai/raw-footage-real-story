# Raw Footage, Real Story — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never be committed.
# TEMPLATE.md law 1: no secret, URL, model name, or binary path is hardcoded in source.
#
# Everything below points at software running on THIS machine. v1 makes no network
# calls and needs no API key — there is deliberately no secret in this file.

# --- Local LLM (Ollama) ----------------------------------------------------
# Base URL of the local Ollama server. Default install listens on 11434.
VITE_OLLAMA_HOST=
# Ollama model tag for the many cheap calls (story ideas, segment selection).
VITE_OLLAMA_MODEL=
# Model for the single final narration call, where quality is worth the latency.
VITE_OLLAMA_MODEL_QUALITY=

# --- Cloud TTS (optional, bring your own key) -------------------------------
# The ElevenLabs key normally lives in the OS keychain, entered in the app.
# This variable overrides it, which is how CI exercises the cloud path on a
# machine with no keychain. Leave blank for normal use.
ELEVENLABS_API_KEY=
# Same for OpenAI script generation. Note this is a very common variable name:
# a key exported in your shell for something else will be used in preference to
# the keychain.
OPENAI_API_KEY=

# --- Local TTS -------------------------------------------------------------
# Which local TTS backend to drive. Chosen at setup time; see README.
VITE_TTS_ENGINE=
# Absolute path to the TTS executable or model directory, if it is not on $PATH.
TTS_BINARY_PATH=
# Voice/speaker id the TTS engine should use for the narration.
VITE_TTS_VOICE=

# --- ffmpeg ----------------------------------------------------------------
# Absolute path to the ffmpeg binary. Leave blank to use whatever is on $PATH.
FFMPEG_PATH=
# Absolute path to ffprobe (clip duration/metadata). Blank = use $PATH.
FFPROBE_PATH=

# --- App -------------------------------------------------------------------
# Where rendered rough cuts and project files are written. Blank = OS app-data dir.
VITE_OUTPUT_DIR=

# --- Development only ------------------------------------------------------
# Project directory holding real HDR clips, for the ignored tone-mapping test.
# Phone HLG footage cannot be synthesised, so that test needs real files:
#   RFRS_HDR_PROJECT="~/Library/…/projects/<id>" \
#     cargo test --lib hdr_check -- --ignored --nocapture
# Not read by the app itself.
RFRS_HDR_PROJECT=

# --- Hub integration (v2 — not used yet, listed so the shape is fixed) ------
# `standalone` (default) or `embedded`. v1 is always standalone.
VITE_APP_MODE=
# PEM public key the hub signs its JWTs with. Only read in embedded mode.
HUB_PUBLIC_KEY=

# Which model the sampling-parameter probe asks about. Test-only; the app
# never reads this. Defaults to the balanced tier when unset.
PROBE_MODEL=

# Which comparison harness the ignored `ollama_vs_openai` test runs. Test-only.
HARNESS=

# Read, but not yours to set: the OS provides these, and the sidebar shows the
# name rather than inventing a profile. Listed so the guard stays strict about
# everything the code reads, including what it only reads.
USER=
USERNAME=

# Read, but not yours to set: Windows provides these, and ffmpeg discovery uses
# them to find what winget and scoop installed. Listed so the guard stays strict
# about everything the code reads, including what it only reads.
LOCALAPPDATA=
USERPROFILE=

# ── signing in to BuildnLaunchAI ───────────────────────────────────────────
#
# All of these are empty here on purpose, and they mean two different things.
#
# VITE_AUTH_GATE is the switch. Unset, the gate is off and the app behaves
# exactly as it did before the gate existed, which is what a build from your
# own machine does unless you say otherwise. The release workflow sets it to
# "on", so every build downloaded from a release asks people to sign in.
#
# The three below it are *overrides*. Unset, the app uses the production
# project compiled into the binary — a downloaded copy has no environment to
# read, so it has to know where the platform is without being told. Set them
# to point a build at staging without recompiling.

# Turns the gate on. Exactly the string "on" and nothing else — an empty value,
# "true", "1" or a typo all mean off, because this blocks the entire
# application and every ambiguous value must fail towards letting people in.
#
#   VITE_AUTH_GATE=on npm run build:app
#
# See .github/workflows/release.yml for the same line in the release build,
# and for why it is written there with quotes around the "on".
VITE_AUTH_GATE=

# The Supabase project URL. One base for all four endpoints: /auth/v1/authorize,
# /auth/v1/token, /functions/v1/desktop-licence and /functions/v1/desktop-keys.
# Blank = the production project compiled into the binary.
#
# Setting this to an empty string is not the same as leaving it unset in a
# shell — an explicit empty value means "unconfigured", and the app reports
# that rather than signing anybody in.
BUILDNLAUNCH_AUTH_URL=

# The project's *publishable* key — the one already in every web page the
# platform serves. Safe in the binary and safe in a log; row-level security is
# what protects the data behind it. Blank = the production project's.
#
# The service_role key must never appear here or anywhere this process can
# reach it. The secret scan above greps for it.
BUILDNLAUNCH_ANON_KEY=

# Which identity provider the browser is handed to. GoTrue has no
# provider-less /authorize — it answers "Unsupported provider" — so this is
# required rather than optional, and blank means the compiled-in default,
# `google`, which is the only external provider enabled on the project today.
BUILDNLAUNCH_AUTH_PROVIDER=
