# Raw Footage, Real Story — environment template.
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must never be committed.
# TEMPLATE.md law 1: no secret, URL, model name, or binary path is hardcoded in source.
#
# Everything below points at software running on THIS machine. v1 makes no network
# calls and needs no API key — there is deliberately no secret in this file.

# --- Local LLM (Ollama) ----------------------------------------------------
# Base URL of the local Ollama server. Default install listens on 11434.
VITE_OLLAMA_HOST=
# Ollama model tag used for script generation, e.g. llama3.1:8b. Must be pulled first.
VITE_OLLAMA_MODEL=

# --- Local TTS -------------------------------------------------------------
# Which local TTS backend to drive. Chosen at setup time; see README.
VITE_TTS_ENGINE=
# Absolute path to the TTS executable or model directory, if it is not on $PATH.
TTS_BINARY_PATH=
# Voice/speaker id the TTS engine should use for the narration.
VITE_TTS_VOICE=

# --- ffmpeg ----------------------------------------------------------------
# Absolute path to the ffmpeg binary. Leave blank to use whatever is on $PATH.
FFMPEG_PATH=
# Absolute path to ffprobe (clip duration/metadata). Blank = use $PATH.
FFPROBE_PATH=

# --- App -------------------------------------------------------------------
# Where rendered rough cuts and project files are written. Blank = OS app-data dir.
VITE_OUTPUT_DIR=

# --- Development only ------------------------------------------------------
# Project directory holding real HDR clips, for the ignored tone-mapping test.
# Phone HLG footage cannot be synthesised, so that test needs real files:
#   RFRS_HDR_PROJECT="~/Library/…/projects/<id>" \
#     cargo test --lib hdr_check -- --ignored --nocapture
# Not read by the app itself.
RFRS_HDR_PROJECT=

# --- Hub integration (v2 — not used yet, listed so the shape is fixed) ------
# `standalone` (default) or `embedded`. v1 is always standalone.
VITE_APP_MODE=
# PEM public key the hub signs its JWTs with. Only read in embedded mode.
HUB_PUBLIC_KEY=
