# --- Environment / secrets -------------------------------------------------
# TEMPLATE.md law 1: zero hardcoded secrets. Real values live here, never in git.
.env
.env.local
.env.*.local
!.env.example

# --- Node / Vite -----------------------------------------------------------
node_modules
dist
dist-ssr
*.local

# The release workflow's gate check builds two control bundles here and
# deletes them again. It only survives a run that failed early, which is
# exactly when somebody is running the check by hand to find out why.
.gate-check/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Rust / Tauri ----------------------------------------------------------
# src-tauri/.gitignore also covers /target and /gen/schemas; kept here so the
# repo root is self-explanatory.
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/WixTools/
**/*.rs.bk

# --- Packaged builds -------------------------------------------------------
# Where a built installer is copied to be tested by hand. The canonical output
# is under src-tauri/target/, which is already ignored above; this is the copy
# that gets pulled out of a CI artifact and left at the repo root, and it is
# tens of megabytes of binary that must never be swept in by `git add -A`.
#
# Anchored, so it means this directory and not any directory anywhere that
# happens to be called "release".
/release/

# --- Bundled model assets --------------------------------------------------
# Kokoro weights and voice packs are tracked via Git LFS (see .gitattributes),
# not ignored: they must ship with the app for the offline guarantee to hold.

# --- App working data ------------------------------------------------------
# Generated media and scratch output: large, machine-local, never committed.
/out/
/renders/
/tmp/
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
# ...but keep any deliberate fixtures used by tests.
!tests/fixtures/**

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Tooling ---------------------------------------------------------------
.claude/settings.local.json
.test-build/

# Fetched by scripts/fetch-model.sh, not stored in the repo.
src-tauri/resources/kokoro/model_quantized.onnx
